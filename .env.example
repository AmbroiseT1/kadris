# Frontend environment variables (copy to .env.local)

# Backend URL used by the Next.js /api/v1 rewrite (server-side, read at build/start).
# Default: http://localhost:8000
API_PROXY_TARGET=http://localhost:8000

# Base URL used by the browser API client (app/lib/api.ts).
# Default when unset: http://127.0.0.1:8000/api/v1
# Set to /api/v1 to go through the Next.js proxy above.
NEXT_PUBLIC_API_URL=/api/v1
