# Copier en .env (jamais commité) et remplir.
DATABASE_URL=postgresql://kadris:CHANGER_MOI@postgres/kadris_data
GEMINI_API_KEY=
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Domaines du frontend, séparés par des virgules
CORS_ORIGINS=http://localhost:3000
# Optionnel : crée/met à jour le compte admin au démarrage de l'API
ADMIN_EMAIL=
ADMIN_PASSWORD=
# IP du reverse proxy (nginx, Traefik...) devant l'API, pour que l'anti brute-force voie la vraie IP client.
# Variable lue par uvicorn (--proxy-headers). Ne jamais mettre * si l'API est joignable sans passer par le proxy.
FORWARDED_ALLOW_IPS=127.0.0.1
