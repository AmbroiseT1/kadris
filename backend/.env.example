# Copier en .env (jamais commité) et remplir.
DATABASE_URL=postgresql://kadris:CHANGER_MOI@postgres/kadris_data
# Sans clé, /documents/analyze répond 503 (GOOGLE_API_KEY est aussi accepté)
GEMINI_API_KEY=
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Domaines du frontend, séparés par des virgules
CORS_ORIGINS=http://localhost:3000
# Optionnel : crée le compte admin au démarrage s'il n'existe pas. Ne réinitialise JAMAIS le mot de passe
# d'un compte existant (pour cela : python create_admin.py).
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Derrière un reverse proxy (nginx, Traefik...), uvicorn doit tourner avec
#   --proxy-headers --forwarded-allow-ips=<IP du proxy>   (le Dockerfile utilise "*")
# pour que l'anti brute-force voie la vraie IP client. Avec "*", l'API ne doit être joignable QUE via le proxy.
# Un seul worker uvicorn : les limiteurs de débit sont en mémoire.
FORWARDED_ALLOW_IPS=127.0.0.1
